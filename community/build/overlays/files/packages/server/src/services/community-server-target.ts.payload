import { db } from "@dokploy/server/db";
import { server } from "@dokploy/server/db/schema";
import { getAccessibleServerIds } from "@dokploy/server/services/server";
import { TRPCError } from "@trpc/server";
import { eq } from "drizzle-orm";
/** Omission retains the inherited deployment-level manager path; it has no tenant ownership model. */
export async function assertCommunityServerTarget(
	serverId: string | undefined,
	organizationId: string,
) {
	if (serverId === undefined) return undefined;
	if (!serverId) throw new TRPCError({ code: "FORBIDDEN" });
	const target = await db.query.server.findFirst({
		where: eq(server.serverId, serverId),
	});
	if (!target || target.organizationId !== organizationId)
		throw new TRPCError({ code: "FORBIDDEN" });
	return target;
}
export async function assertCommunityServerAccess(
	serverId: string | undefined,
	session: Parameters<typeof getAccessibleServerIds>[0],
) {
	const target = await assertCommunityServerTarget(
		serverId,
		session.activeOrganizationId,
	);
	if (target && !(await getAccessibleServerIds(session)).has(target.serverId))
		throw new TRPCError({ code: "FORBIDDEN" });
	return target;
}
